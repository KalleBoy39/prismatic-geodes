		"sources": "https://github.com/KalleBoy39/prismatic-geodes",
		"issues": "https://github.com/KalleBoy39/prismatic-geodes/issues"
	},
	"license": [
		"MIT",
		"LicenseRef-Minecraft-derived-assets"
	],
	"icon": "assets/vplus_geodes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.vplus.geodes.VanillaPlusGeodes"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
